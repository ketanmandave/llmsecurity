# Copy this file to .env before starting Docker Compose.
# Use strong, unique values outside a local development machine.
APP_NAME=SentinelAICollege
ENV=development
SECRET_KEY=replace-with-a-long-random-secret

POSTGRES_DB=sentinelaidb_college
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password

SENTINEL_DB_PORT=5433
SENTINEL_REDIS_PORT=6380
SENTINEL_BACKEND_PORT=8000
SENTINEL_FRONTEND_PORT=5174
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SENTINEL_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional provider keys. RAG retrieval works without GROQ, but generated RAG
# answers require GROQ. Sentinel's normal assistant provider can use OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_RETRY_COUNT=1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_TIMEOUT_SECONDS=30
GROQ_RETRY_COUNT=2

REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_RATE_LIMIT_MAX_REQUESTS=100
