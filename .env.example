APP_NAME=Secure Role-Aware RAG
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://secure_rag:secure_rag@localhost:5432/secure_rag
POSTGRES_DB=secure_rag
POSTGRES_USER=secure_rag
POSTGRES_PASSWORD=secure_rag
POSTGRES_PORT=5432
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_PDF_PAGES=500
CHUNK_SIZE_WORDS=450
CHUNK_OVERLAP_WORDS=75
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
MODEL_CACHE_DIRECTORY=.model_cache
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
RETRIEVAL_MIN_SCORE=0.2
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_MAX_CANDIDATES=50
RETRIEVAL_FINAL_MIN_SCORE=0.35
RETRIEVAL_RELATIVE_SCORE_MARGIN=0.12
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
RAG_MAX_CONTEXT_CHARACTERS=24000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6380/0
REDIS_PORT=6380
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=company-backend
JWT_AUDIENCE=secure-rag
JWT_LEEWAY_SECONDS=30
