FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY backend/requirements.txt ./requirements.txt
# The semantic detector runs on CPU in the Compose deployment. Preinstalling
# the official CPU wheel prevents pip from pulling several GB of CUDA runtime
# packages into an image that has no GPU runtime.
RUN pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app

# Runtime configuration is injected by Compose/the deployment platform. Secrets
# are intentionally not copied into the image.
RUN mkdir -p /app/uploads /app/.model_cache

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
