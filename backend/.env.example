APP_NAME=SentinelAICollege
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/sentinelaidb_college
REDIS_URL=redis://localhost:6380/0
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_RETRY_COUNT=1

# Secure RAG settings
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_PDF_PAGES=500
DUPLICATE_DOCUMENT_POLICY=warn
CHUNK_SIZE_WORDS=450
CHUNK_OVERLAP_WORDS=75
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
MODEL_CACHE_DIRECTORY=.model_cache
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
RETRIEVAL_MIN_SCORE=0.2
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_MAX_CANDIDATES=50
RETRIEVAL_FINAL_MIN_SCORE=0.35
RETRIEVAL_RELATIVE_SCORE_MARGIN=0.12
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
RAG_MAX_CONTEXT_CHARACTERS=24000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_TIMEOUT_SECONDS=30
GROQ_RETRY_COUNT=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
